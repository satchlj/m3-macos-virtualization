diff --git a/tests/python/test_proxyclient/test_m1n1/test_proxy_vel2.py b/tests/python/test_proxyclient/test_m1n1/test_proxy_vel2.py
new file mode 100644
index 0000000..b46f3c5
--- /dev/null
+++ b/tests/python/test_proxyclient/test_m1n1/test_proxy_vel2.py
@@ -0,0 +1,88 @@
+# SPDX-License-Identifier: MIT
+"""Host-independent tests for the virtual EL2 proxy API."""
+
+import pytest
+
+from proxyclient.m1n1.proxy import M1N1Proxy
+
+
+def proxy_with_replies(replies=None):
+    proxy = object.__new__(M1N1Proxy)
+    calls = []
+    replies = replies or {}
+
+    def request(opcode, *args):
+        calls.append((opcode, *args))
+        if opcode in (proxy.P_HV_VEL2_TPIDR_GL2_QUERY,
+                      proxy.P_HV_VEL2_STEP_FILTER_QUERY):
+            return replies[args[0]]
+        return 0
+
+    proxy.request = request
+    return proxy, calls
+
+
+def test_tpidr_gl2_fast_shadow_enable_and_disable():
+    proxy, calls = proxy_with_replies()
+    proxy.hv_vel2_tpidr_gl2_shadow_enable(0xb0c0, 0xfffffe00070c0000)
+    proxy.hv_vel2_tpidr_gl2_shadow_disable()
+    assert calls == [
+        (proxy.P_HV_VEL2_TPIDR_GL2_CONFIG, 1, 0xb0c0, 0xfffffe00070c0000),
+        (proxy.P_HV_VEL2_TPIDR_GL2_CONFIG, 0, 0, 0),
+    ]
+
+
+def test_tpidr_gl2_fast_shadow_status_schema():
+    proxy, calls = proxy_with_replies({
+        0: 1, 1: 0xb0c0, 2: 0xfffffe00070c0000,
+        3: 1234, 4: 2, 5: 17,
+    })
+    assert proxy.hv_vel2_tpidr_gl2_shadow_status() == {
+        "enabled": True,
+        "tag_base": 0xb0c0,
+        "shadow": 0xfffffe00070c0000,
+        "reads": 1234,
+        "writes": 2,
+        "forwarded": 17,
+    }
+    assert calls == [
+        (proxy.P_HV_VEL2_TPIDR_GL2_QUERY, selector) for selector in range(6)
+    ]
+
+
+def test_tpidr_gl2_fast_shadow_rejects_unknown_status_selector():
+    proxy, _ = proxy_with_replies({6: 0xffffffffffffffff})
+    with pytest.raises(ValueError):
+        proxy._hv_vel2_tpidr_gl2_query(6)
+
+
+def test_step_filter_enable_status_and_disable():
+    reply = {
+        0: 1, 1: 1, 2: 123, 3: 0x1004, 4: 0x2008,
+        5: 0x2004, 6: 100, 7: 23, 8: 2, 9: 0x3000, 10: 4096,
+        11: 0x1000, 12: 0x1100, 13: 0x2000, 14: 0x2100,
+        15: 0x1004,
+    }
+    proxy, calls = proxy_with_replies(reply)
+    proxy.hv_vel2_step_filter_enable(
+        0x1000, 0x1100, 0x2000, 0x2100, 0x3000, 4096, 0x1004)
+    assert proxy.hv_vel2_step_filter_status() == {
+        "active": True, "status": 1, "steps": 123,
+        "first_pc": 0x1004, "last_pc": 0x2008,
+        "previous_pc": 0x2004, "range0_hits": 100,
+        "range1_hits": 23, "range_switches": 2,
+        "terminal_pc": 0x3000, "max_steps": 4096,
+        "range0_start": 0x1000, "range0_end": 0x1100,
+        "range1_start": 0x2000, "range1_end": 0x2100,
+        "expected_first_pc": 0x1004,
+    }
+    proxy.hv_vel2_step_filter_disable()
+    assert calls[0] == (
+        proxy.P_HV_VEL2_STEP_FILTER_CONFIG,
+        0x1000, 0x1100, 0x2000, 0x2100, 0x3000, 4096)
+    assert calls[1] == (proxy.P_HV_VEL2_STEP_FILTER_EXPECT, 0x1004)
+    assert calls[2:18] == [
+        (proxy.P_HV_VEL2_STEP_FILTER_QUERY, selector)
+        for selector in range(16)]
+    assert calls[18] == (
+        proxy.P_HV_VEL2_STEP_FILTER_CONFIG, 0, 0, 0, 0, 0, 0)
