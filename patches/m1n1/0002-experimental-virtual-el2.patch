diff --git a/src/hv_vel2.c b/src/hv_vel2.c
new file mode 100644
index 0000000..6a89c34
--- /dev/null
+++ b/src/hv_vel2.c
@@ -0,0 +1,273 @@
+/* SPDX-License-Identifier: MIT */
+#include "hv_vel2.h"
+#include "vel2_state.h"
+#include "vel2_trace.h"
+#include "vel2_step_filter.h"
+#include "hv_sprr.h"
+#include "smp.h"
+#include "string.h"
+#include "uart.h"
+#include "cpu_regs.h"
+
+static struct vel2_state states[MAX_CPUS];
+static struct vel2_trace traces[MAX_CPUS];
+static struct vel2_step_filter step_filters[MAX_CPUS];
+
+struct vel2_tpidr_gl2_fast {
+    bool enabled;
+    u16 tag_base;
+    u64 shadow, reads, writes, forwarded;
+};
+
+static struct vel2_tpidr_gl2_fast tpidr_gl2_fast[MAX_CPUS];
+
+enum vel2_tpidr_gl2_result {
+    TPIDR_GL2_DISABLED,
+    TPIDR_GL2_HANDLED,
+    TPIDR_GL2_FORWARD,
+};
+
+static void hv_vel2_tpidr_gl2_reset(void)
+{
+    tpidr_gl2_fast[smp_id()] = (struct vel2_tpidr_gl2_fast){};
+}
+
+static enum vel2_tpidr_gl2_result hv_vel2_tpidr_gl2_handle(struct exc_info *ctx, u16 imm)
+{
+    struct vel2_tpidr_gl2_fast *fast = &tpidr_gl2_fast[smp_id()];
+    if (!fast->enabled)
+        return TPIDR_GL2_DISABLED;
+
+    u16 tag_base = imm & ~0x3f;
+    u8 rt = imm & 31;
+    if (tag_base != fast->tag_base) {
+        fast->forwarded++;
+        return TPIDR_GL2_FORWARD;
+    }
+    if (imm & 0x20) {
+        if (rt != 31)
+            ctx->regs[rt] = fast->shadow;
+        fast->reads++;
+        return TPIDR_GL2_HANDLED;
+    }
+
+    fast->shadow = rt == 31 ? 0 : ctx->regs[rt];
+    fast->writes++;
+    return TPIDR_GL2_HANDLED;
+}
+
+bool hv_vel2_active(void)
+{
+    return states[smp_id()].enabled;
+}
+
+int hv_vel2_set_active(bool enabled)
+{
+    /* Fast shadows never survive a VEL2 disable or a new VEL2 session. */
+    hv_vel2_tpidr_gl2_reset();
+    if (enabled && hv_sprr_active)
+        return -1; /* Combining guarded worlds needs a separate implementation. */
+    if (states[smp_id()].regs[VE_SCTLR] & 1) {
+        msr(SYS_SCTLR_EL12, 0x30d00800);
+        sysop("isb");
+        sysop("dsb ishst");
+        sysop("tlbi vmalle1is");
+        sysop("dsb ish");
+        sysop("isb");
+    }
+    vel2_trace_configure(&traces[smp_id()], NULL, 0);
+    vel2_step_filter_reset(&step_filters[smp_id()]);
+    vel2_reset(&states[smp_id()], enabled);
+    return 0;
+}
+
+bool hv_vel2_handle(struct exc_info *ctx, u16 imm)
+{
+    enum vel2_tpidr_gl2_result fast = hv_vel2_tpidr_gl2_handle(ctx, imm);
+    if (fast == TPIDR_GL2_HANDLED) {
+        if (step_filters[smp_id()].status == VE_STEP_FILTER_RUNNING)
+            ctx->spsr |= 1ULL << 21;
+        return true;
+    }
+    if (fast == TPIDR_GL2_FORWARD)
+        return false;
+
+    struct vel2_frame f = {.pc = ctx->elr, .pstate = ctx->spsr, .sp = ctx->sp[1]};
+    memcpy(f.x, ctx->regs, sizeof(f.x));
+    struct vel2_state *state = &states[smp_id()];
+    u64 old_sctlr = state->regs[VE_SCTLR];
+    enum vel2_result result = vel2_handle(state, &f, imm);
+    if (result != VE_OK) {
+        printf("VEL2-STAGE stopped reason=%d hvc=%x\n", result, imm);
+        return false;
+    }
+    if (old_sctlr != state->regs[VE_SCTLR]) {
+        /* EL12 aliases address only guest stage 1 under host VHE. */
+        msr(SYS_SCTLR_EL12, 0x30d00800);
+        sysop("isb");
+        if (state->regs[VE_SCTLR] & 1) {
+            /* EL2 PS[18:16] becomes EL1 IPS[34:32]; disable TTBR1 walks. */
+            u64 tcr = (state->regs[VE_TCR] & 0xffff) | (3ULL << 32) | (1ULL << 23) | (1ULL << 30) | (22ULL << 16);
+            if (state->regs[VE_HCR] == VE_HCR_VHE)
+                tcr = state->regs[VE_TCR];
+            msr(SYS_MAIR_EL12, state->regs[VE_MAIR]);
+            msr(SYS_TCR_EL12, tcr);
+            msr(SYS_TTBR0_EL12, state->regs[VE_TTBR0]);
+        }
+        sysop("dsb ishst");
+        sysop("tlbi vmalle1is");
+        sysop("dsb ish");
+        sysop("isb");
+        msr(SYS_SCTLR_EL12, 0x30d00800 | (state->regs[VE_SCTLR] & 1));
+        sysop("isb");
+    }
+    /* An emulated exception return/HVC can restore a saved PSTATE with SS clear.
+     * Keep a bounded filtered run armed across that world transition; the next
+     * step policy check still owns the PC range and terminal gate. */
+    if (step_filters[smp_id()].status == VE_STEP_FILTER_RUNNING)
+        f.pstate |= 1ULL << 21;
+    memcpy(ctx->regs, f.x, sizeof(f.x));
+    ctx->elr = f.pc;
+    ctx->spsr = f.pstate;
+    ctx->sp[1] = f.sp;
+    return true;
+}
+
+int hv_vel2_trace_config(void *buffer, u64 capacity)
+{
+    if (capacity && !hv_vel2_active())
+        return -1;
+    return vel2_trace_configure(&traces[smp_id()], buffer, capacity);
+}
+
+u64 hv_vel2_trace_count(void)
+{
+    return traces[smp_id()].count;
+}
+
+bool hv_vel2_trace_step(struct exc_info *ctx)
+{
+    if (!hv_vel2_active())
+        return false;
+    struct vel2_trace_record record = {
+        .pc = ctx->elr, .esr = ctx->esr, .far = ctx->far, .pstate = ctx->spsr,
+    };
+    memcpy(record.regs, ctx->regs, sizeof(record.regs));
+    memcpy(record.sp, ctx->sp, sizeof(record.sp));
+    if (!vel2_trace_push(&traces[smp_id()], &record))
+        return false;
+    ctx->spsr |= 1ULL << 21; /* Re-arm stepping; never advance the saved PC. */
+    return true;
+}
+
+int hv_vel2_step_filter_config(u64 range0_start, u64 range0_end,
+                               u64 range1_start, u64 range1_end,
+                               u64 terminal_pc, u64 max_steps)
+{
+    if (max_steps && !hv_vel2_active())
+        return -1;
+    return vel2_step_filter_configure(&step_filters[smp_id()],
+                                      range0_start, range0_end,
+                                      range1_start, range1_end,
+                                      terminal_pc, max_steps);
+}
+
+int hv_vel2_step_filter_expect(u64 expected_first_pc)
+{
+    return vel2_step_filter_expect(&step_filters[smp_id()], expected_first_pc);
+}
+
+u64 hv_vel2_step_filter_query(u64 selector)
+{
+    struct vel2_step_filter *filter = &step_filters[smp_id()];
+    switch (selector) {
+        case 0:
+            return filter->status == VE_STEP_FILTER_RUNNING;
+        case 1:
+            return filter->status;
+        case 2:
+            return filter->steps;
+        case 3:
+            return filter->first_pc;
+        case 4:
+            return filter->last_pc;
+        case 5:
+            return filter->previous_pc;
+        case 6:
+            return filter->range_hits[0];
+        case 7:
+            return filter->range_hits[1];
+        case 8:
+            return filter->range_switches;
+        case 9:
+            return filter->terminal_pc;
+        case 10:
+            return filter->max_steps;
+        case 11:
+            return filter->range_start[0];
+        case 12:
+            return filter->range_end[0];
+        case 13:
+            return filter->range_start[1];
+        case 14:
+            return filter->range_end[1];
+        case 15:
+            return filter->expected_first_pc;
+        default:
+            return UINT64_MAX;
+    }
+}
+
+enum vel2_step_filter_result hv_vel2_step_filter_step(struct exc_info *ctx)
+{
+    struct vel2_step_filter *filter = &step_filters[smp_id()];
+    bool valid_context = vel2_step_filter_valid_context(
+        FIELD_GET(ESR_EC, ctx->esr), ctx->spsr);
+    enum vel2_step_filter_result result = vel2_step_filter_handle(
+        filter, ctx->elr, valid_context);
+    if (result == VE_STEP_FILTER_HANDLED)
+        ctx->spsr |= 1ULL << 21;
+    return result;
+}
+
+int hv_vel2_tpidr_gl2_config(bool enabled, u64 tag_base, u64 shadow)
+{
+    hv_vel2_tpidr_gl2_reset();
+    if (!enabled)
+        return 0;
+    if (!hv_vel2_active() || tag_base > UINT16_MAX)
+        return -1;
+
+    /* Probe sysreg HVCs use bit 15, bits 13:6 as the register index,
+     * bit 5 as direction, and bits 4:0 as Rt. Accept one exact index. */
+    if ((tag_base & 0xc03f) != 0x8000)
+        return -1;
+
+    tpidr_gl2_fast[smp_id()] = (struct vel2_tpidr_gl2_fast){
+        .enabled = true,
+        .tag_base = tag_base,
+        .shadow = shadow,
+    };
+    return 0;
+}
+
+u64 hv_vel2_tpidr_gl2_query(u64 selector)
+{
+    struct vel2_tpidr_gl2_fast *fast = &tpidr_gl2_fast[smp_id()];
+    switch (selector) {
+        case 0:
+            return fast->enabled;
+        case 1:
+            return fast->tag_base;
+        case 2:
+            return fast->shadow;
+        case 3:
+            return fast->reads;
+        case 4:
+            return fast->writes;
+        case 5:
+            return fast->forwarded;
+        default:
+            return UINT64_MAX;
+    }
+}
