diff --git a/src/vel2_state.c b/src/vel2_state.c
new file mode 100644
index 0000000..01aae22
--- /dev/null
+++ b/src/vel2_state.c
@@ -0,0 +1,99 @@
+/* SPDX-License-Identifier: MIT */
+#include "vel2_state.h"
+
+#define MODE_MASK 0xfULL
+#define EL1H 5ULL
+#define EL2H 9ULL
+#define DAIF 0x3c0ULL
+#define NZCV 0xf0000000ULL
+#define PSTATE_ALLOWED (MODE_MASK | DAIF | NZCV)
+
+void vel2_reset(struct vel2_state *s, bool enabled)
+{
+    *s = (struct vel2_state){.enabled = enabled, .pstate = EL2H | DAIF};
+}
+
+bool vel2_mmu_config_valid(const struct vel2_state *s)
+{
+    return s->regs[VE_TCR] == (s->regs[VE_HCR] == VE_HCR_VHE ? VE_TCR_VHE_16K_42 : VE_TCR_16K_42) &&
+           s->regs[VE_MAIR] == 0xff && s->regs[VE_TTBR0] != 0 &&
+           !(s->regs[VE_TTBR0] & ~((1ULL << 42) - 0x4000));
+}
+
+static enum vel2_result access_reg(struct vel2_state *s, struct vel2_frame *f,
+                                    unsigned reg, bool read, unsigned rt)
+{
+    if (reg >= VE_REG_COUNT || rt > 31)
+        return VE_BAD_ACCESS;
+    if (reg != VE_CURRENTEL && (s->pstate & MODE_MASK) != EL2H)
+        return VE_BAD_ACCESS;
+    if (!read && reg == VE_CURRENTEL)
+        return VE_BAD_ACCESS;
+    uint64_t value = rt == 31 ? 0 : f->x[rt];
+    if (!read) {
+        /* Narrow synthetic regime: no cache enable or unmodelled SCTLR bits. */
+        if (reg == VE_SCTLR && (value & ~1ULL))
+            return VE_UNSUPPORTED;
+        if (reg == VE_SCTLR && (value & 1) && !vel2_mmu_config_valid(s))
+            return VE_UNSUPPORTED;
+        if (reg == VE_HCR && value != 0 && value != VE_HCR_VHE)
+            return VE_UNSUPPORTED;
+        /* No live table-root/control changes until TLBI/context semantics exist. */
+        if ((s->regs[VE_SCTLR] & 1) &&
+            (reg == VE_TCR || reg == VE_TTBR0 || reg == VE_MAIR || reg == VE_HCR))
+            return VE_UNSUPPORTED;
+        if (reg == VE_VBAR && (value & 0x7ff))
+            return VE_BAD_ACCESS;
+        s->regs[reg] = value;
+    } else if (rt != 31) {
+        f->x[rt] = reg == VE_CURRENTEL ? ((s->pstate & MODE_MASK) == EL2H ? 8 : 4)
+                                       : s->regs[reg];
+    }
+    return VE_OK;
+}
+
+static enum vel2_result exception_return(struct vel2_state *s, struct vel2_frame *f)
+{
+    uint64_t target = s->regs[VE_SPSR];
+    uint64_t mode = target & MODE_MASK;
+    if ((s->pstate & MODE_MASK) != EL2H)
+        return VE_BAD_ACCESS;
+    if ((s->regs[VE_SCTLR] & 1) || (mode == EL1H && s->regs[VE_HCR] == VE_HCR_VHE))
+        return VE_UNSUPPORTED; /* A lower-world translation context is not implemented yet. */
+    if ((mode != EL1H && mode != EL2H) || (target & ~PSTATE_ALLOWED))
+        return VE_UNSUPPORTED;
+    if (s->regs[VE_ELR] & 3)
+        return VE_BAD_ACCESS;
+    s->sp_el2 = f->sp;
+    if (mode == EL1H)
+        f->sp = s->regs[VE_SP_EL1];
+    s->pstate = target;
+    f->pc = s->regs[VE_ELR];
+    /* Both virtual levels execute physically at EL1h with IRQs masked. */
+    f->pstate = (target & NZCV) | DAIF | EL1H;
+    return VE_OK;
+}
+
+enum vel2_result vel2_handle(struct vel2_state *s, struct vel2_frame *f, uint16_t imm)
+{
+    if (!s->enabled)
+        return VE_DISABLED;
+    if ((imm & 0xf800) == VE_REG_HVC)
+        return access_reg(s, f, (imm >> 6) & 0x1f, (imm & 0x20) != 0, imm & 31);
+    if (imm == VE_ERET_HVC)
+        return exception_return(s, f);
+    if (imm == VE_STOP_HVC || (s->pstate & MODE_MASK) != EL1H)
+        return VE_UNSUPPORTED;
+    if (!s->regs[VE_VBAR] || s->regs[VE_VBAR] > UINT64_MAX - 0x400)
+        return VE_BAD_ACCESS;
+    /* AArch64 HVC from virtual EL1: lower-EL synchronous vector, PC after HVC. */
+    s->regs[VE_SPSR] = (s->pstate & ~NZCV) | (f->pstate & NZCV);
+    s->regs[VE_ELR] = f->pc;
+    s->regs[VE_ESR] = (0x16ULL << 26) | (1ULL << 25) | imm;
+    s->regs[VE_SP_EL1] = f->sp;
+    f->sp = s->sp_el2;
+    f->pc = s->regs[VE_VBAR] + 0x400;
+    s->pstate = (s->regs[VE_SPSR] & NZCV) | DAIF | EL2H;
+    f->pstate = (s->pstate & NZCV) | DAIF | EL1H;
+    return VE_OK;
+}
diff --git a/src/vel2_state.h b/src/vel2_state.h
new file mode 100644
index 0000000..bb35688
--- /dev/null
+++ b/src/vel2_state.h
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef VEL2_STATE_H
+#define VEL2_STATE_H
+#include <stdbool.h>
+#include <stdint.h>
+
+/* Experimental MMU-off state machine, shared by native tests and the proxy. */
+enum vel2_reg {
+    VE_CURRENTEL, VE_SCTLR, VE_TCR, VE_TTBR0, VE_HCR, VE_VBAR, VE_ELR,
+    VE_SPSR, VE_ESR, VE_FAR, VE_SP_EL1, VE_TPIDR, VE_MAIR, VE_REG_COUNT
+};
+enum vel2_result { VE_OK, VE_DISABLED, VE_BAD_ACCESS, VE_UNSUPPORTED };
+#define VE_REG_HVC 0x4000
+#define VE_ERET_HVC 0x4800
+#define VE_STOP_HVC 0x7fff
+
+struct vel2_state {
+    uint64_t regs[VE_REG_COUNT];
+    uint64_t pstate, sp_el2;
+    bool enabled;
+};
+struct vel2_frame {
+    uint64_t x[32];
+    uint64_t pc, pstate, sp;
+};
+/* First supported non-VHE EL2 translation regime: 42-bit VA/PA, 16K, WB walks. */
+#define VE_TCR_16K_42 0x8083b516ULL
+#define VE_HCR_VHE 0x408000000ULL
+#define VE_TCR_VHE_16K_42 0x34096b516ULL
+bool vel2_mmu_config_valid(const struct vel2_state *s);
+void vel2_reset(struct vel2_state *s, bool enabled);
+enum vel2_result vel2_handle(struct vel2_state *s, struct vel2_frame *f, uint16_t imm);
+#endif
diff --git a/src/vel2_step_filter.c b/src/vel2_step_filter.c
new file mode 100644
index 0000000..c381be0
--- /dev/null
+++ b/src/vel2_step_filter.c
@@ -0,0 +1,102 @@
+/* SPDX-License-Identifier: MIT */
+#include "vel2_step_filter.h"
+
+void vel2_step_filter_reset(struct vel2_step_filter *filter)
+{
+    *filter = (struct vel2_step_filter){};
+}
+
+int vel2_step_filter_expect(struct vel2_step_filter *filter,
+                            uint64_t expected_first_pc)
+{
+    if (filter->status != VE_STEP_FILTER_RUNNING || filter->steps ||
+        (expected_first_pc & 3) ||
+        !((filter->range_start[0] <= expected_first_pc &&
+           expected_first_pc < filter->range_end[0]) ||
+          (filter->range_start[1] <= expected_first_pc &&
+           expected_first_pc < filter->range_end[1])))
+        return -1;
+    filter->expected_first_pc = expected_first_pc;
+    return 0;
+}
+
+int vel2_step_filter_configure(struct vel2_step_filter *filter,
+                               uint64_t range0_start, uint64_t range0_end,
+                               uint64_t range1_start, uint64_t range1_end,
+                               uint64_t terminal_pc, uint64_t max_steps)
+{
+    vel2_step_filter_reset(filter);
+    if (!max_steps)
+        return 0;
+    if (max_steps > VE_STEP_FILTER_MAX_STEPS || range0_start >= range0_end ||
+        range1_start >= range1_end ||
+        ((range0_start | range0_end | range1_start | range1_end |
+          terminal_pc) & 3))
+        return -1;
+
+    *filter = (struct vel2_step_filter){
+        .range_start = {range0_start, range1_start},
+        .range_end = {range0_end, range1_end},
+        .terminal_pc = terminal_pc,
+        .max_steps = max_steps,
+        .last_range = UINT8_MAX,
+        .status = VE_STEP_FILTER_RUNNING,
+    };
+    return 0;
+}
+
+bool vel2_step_filter_valid_context(uint32_t ec, uint64_t spsr)
+{
+    uint64_t mode = spsr & 15;
+
+    /* Guarded TXM executes at EL0t; SPTM callbacks use EL1t or EL1h. */
+    return ec == 0x32 && (mode == 0 || mode == 4 || mode == 5);
+}
+
+enum vel2_step_filter_result vel2_step_filter_handle(
+    struct vel2_step_filter *filter, uint64_t pc, bool valid_context)
+{
+    if (filter->status != VE_STEP_FILTER_RUNNING)
+        return VE_STEP_FILTER_INACTIVE;
+
+    filter->previous_pc = filter->last_pc;
+    filter->last_pc = pc;
+    if (!valid_context) {
+        filter->status = VE_STEP_FILTER_BAD_CONTEXT;
+        return VE_STEP_FILTER_STOP;
+    }
+    if (!filter->steps && filter->expected_first_pc &&
+        pc != filter->expected_first_pc) {
+        filter->status = VE_STEP_FILTER_ENTRY_MISMATCH;
+        return VE_STEP_FILTER_STOP;
+    }
+    if (pc == filter->terminal_pc) {
+        filter->status = VE_STEP_FILTER_TERMINAL;
+        return VE_STEP_FILTER_STOP;
+    }
+
+    unsigned int range = 2;
+    for (unsigned int i = 0; i < 2; i++) {
+        if (filter->range_start[i] <= pc && pc < filter->range_end[i]) {
+            range = i;
+            break;
+        }
+    }
+    if (range == 2) {
+        filter->status = VE_STEP_FILTER_OUTSIDE;
+        return VE_STEP_FILTER_STOP;
+    }
+    if (filter->steps >= filter->max_steps) {
+        filter->status = VE_STEP_FILTER_LIMIT;
+        return VE_STEP_FILTER_STOP;
+    }
+
+    if (!filter->steps)
+        filter->first_pc = pc;
+    if (filter->last_range != UINT8_MAX && filter->last_range != range)
+        filter->range_switches++;
+    filter->last_range = range;
+    filter->range_hits[range]++;
+    filter->steps++;
+    return VE_STEP_FILTER_HANDLED;
+}
