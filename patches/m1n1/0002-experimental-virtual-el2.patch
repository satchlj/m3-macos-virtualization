diff --git a/proxyclient/m1n1/hv/vel2.py b/proxyclient/m1n1/hv/vel2.py
new file mode 100644
index 0000000..3a6121a
--- /dev/null
+++ b/proxyclient/m1n1/hv/vel2.py
@@ -0,0 +1,32 @@
+# SPDX-License-Identifier: MIT
+"""Synthetic MMU-off virtual EL2 instruction translation; not an Apple loader."""
+import struct
+from .. import sysreg
+
+REGISTERS = [sysreg.CurrentEL, sysreg.SCTLR_EL2, sysreg.TCR_EL2, sysreg.TTBR0_EL2,
+             sysreg.HCR_EL2, sysreg.VBAR_EL2, sysreg.ELR_EL2, sysreg.SPSR_EL2,
+             sysreg.ESR_EL2, sysreg.FAR_EL2, sysreg.SP_EL1, sysreg.TPIDR_EL2, sysreg.MAIR_EL2]
+REG_HVC = 0x4000
+ERET_HVC = 0x4800
+STOP_HVC = 0x7fff
+
+
+def sysreg_opcode(reg, read):
+    op0, op1, crn, crm, op2 = reg
+    return (0xd5000000 | (int(read) << 21) | (op0 << 19) | (op1 << 16) |
+            (crn << 12) | (crm << 8) | (op2 << 5))
+
+
+def patch_synthetic_code(data):
+    if len(data) % 4:
+        raise ValueError('Instruction stream must be word aligned')
+    opcodes = {sysreg_opcode(reg, read): REG_HVC | (i << 6) | (read << 5)
+               for i, reg in enumerate(REGISTERS) for read in (0, 1)}
+    words = []
+    for (word,) in struct.iter_unpack('<I', data):
+        if word == 0xd69f03e0:  # ERET
+            word = 0xd4000002 | (ERET_HVC << 5)
+        elif word & ~31 in opcodes:
+            word = 0xd4000002 | ((opcodes[word & ~31] | (word & 31)) << 5)
+        words.append(word)
+    return b''.join(struct.pack('<I', word) for word in words)
