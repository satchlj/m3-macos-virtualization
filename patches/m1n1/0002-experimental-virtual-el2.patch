+/* SPDX-License-Identifier: MIT */
+#ifndef VEL2_STEP_FILTER_H
+#define VEL2_STEP_FILTER_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define VE_STEP_FILTER_MAX_STEPS (1ULL << 24)
+
+enum vel2_step_filter_status {
+    VE_STEP_FILTER_DISABLED,
+    VE_STEP_FILTER_RUNNING,
+    VE_STEP_FILTER_ENTRY_MISMATCH,
+    VE_STEP_FILTER_TERMINAL,
+    VE_STEP_FILTER_OUTSIDE,
+    VE_STEP_FILTER_LIMIT,
+    VE_STEP_FILTER_BAD_CONTEXT,
+};
+
+enum vel2_step_filter_result {
+    VE_STEP_FILTER_INACTIVE,
+    VE_STEP_FILTER_HANDLED,
+    VE_STEP_FILTER_STOP,
+};
+
+struct vel2_step_filter {
+    uint64_t range_start[2], range_end[2];
+    uint64_t terminal_pc, expected_first_pc, max_steps, steps;
+    uint64_t first_pc, previous_pc, last_pc;
+    uint64_t range_hits[2], range_switches;
+    uint8_t last_range;
+    enum vel2_step_filter_status status;
+};
+
+void vel2_step_filter_reset(struct vel2_step_filter *filter);
+int vel2_step_filter_configure(struct vel2_step_filter *filter,
+                               uint64_t range0_start, uint64_t range0_end,
+                               uint64_t range1_start, uint64_t range1_end,
+                               uint64_t terminal_pc, uint64_t max_steps);
+int vel2_step_filter_expect(struct vel2_step_filter *filter,
+                            uint64_t expected_first_pc);
+bool vel2_step_filter_valid_context(uint32_t ec, uint64_t spsr);
+enum vel2_step_filter_result vel2_step_filter_handle(
+    struct vel2_step_filter *filter, uint64_t pc, bool valid_context);
+
+#endif
diff --git a/src/vel2_trace.c b/src/vel2_trace.c
new file mode 100644
index 0000000..da2e934
--- /dev/null
+++ b/src/vel2_trace.c
@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: MIT */
+#include "vel2_trace.h"
+int vel2_trace_configure(struct vel2_trace *trace, struct vel2_trace_record *records, uint64_t capacity)
+{
+    if (capacity > VE_TRACE_MAX || (capacity && (!records || ((uintptr_t)records & 7))))
+        return -1;
+    *trace = (struct vel2_trace){.records = records, .capacity = capacity};
+    return 0;
+}
+bool vel2_trace_push(struct vel2_trace *trace, const struct vel2_trace_record *record)
+{
+    /* Only ordinary lower-EL AArch64 software-step exceptions at physical EL1. */
+    uint64_t mode = record->pstate & 15;
+    if ((record->esr >> 26) != 0x32 || (mode != 4 && mode != 5) ||
+        !trace->records || trace->count >= trace->capacity)
+        return false;
+    trace->records[trace->count++] = *record;
+    return true;
+}
