+        self._hv_vel2_step_filter_config(range0_start, range0_end,
+                                         range1_start, range1_end,
+                                         terminal_pc, max_steps)
+        if self.request(self.P_HV_VEL2_STEP_FILTER_EXPECT,
+                        expected_first_pc) != 0:
+            raise RuntimeError("Invalid virtual EL2 step-filter first PC")
+
+    def hv_vel2_step_filter_status(self):
+        names = ("active", "status", "steps", "first_pc", "last_pc",
+                 "previous_pc", "range0_hits", "range1_hits",
