diff --git a/proxyclient/m1n1/guest_boot.py b/proxyclient/m1n1/guest_boot.py
new file mode 100644
index 0000000..6ccd2a7
--- /dev/null
+++ b/proxyclient/m1n1/guest_boot.py
@@ -0,0 +1,34 @@
+# SPDX-License-Identifier: MIT
+"""Guest setup validation; helpers perform no device I/O."""
+def bootargs_serializer(bootargs, serializers):
+    revision = bootargs.revision
+    if not isinstance(revision, int) or isinstance(revision, bool) or revision not in serializers:
+        raise ValueError(f"Unsupported guest bootargs revision {revision!r}; refusing guest setup")
+    serializer = serializers[revision]
+    # Validate the current structure before any guest memory/map changes.
+    serializer.build(bootargs)
+    return serializer
+
+
+def select_guest_cpus(nodes, spec=None, single_core=False):
+    if spec is None and not single_core:
+        return None
+    if spec is not None and single_core:
+        raise ValueError("Choose either --cpus or --single-core")
+    nodes = list(nodes)
+    running = [node.name for node in nodes if node.state == 'running']
+    if len(running) != 1:
+        raise ValueError("CPU selection requires exactly one observed running boot CPU")
+    if single_core:
+        return {running[0]}
+    # Preserve legacy -C 012; comma-delimited form supports multi-digit IDs.
+    ids = spec.split(',') if ',' in spec else list(spec)
+    if not ids or any(not value or not value.isascii() or not value.isdecimal() for value in ids):
+        raise ValueError("Invalid CPU selector; use legacy digits or comma-separated IDs")
+    wanted = {f'cpu{int(value)}' for value in ids}
+    available = {node.name for node in nodes}
+    if not wanted <= available:
+        raise ValueError("CPU selector contains CPUs absent from the device tree")
+    if running[0] not in wanted:
+        raise ValueError("CPU selection must retain the running boot CPU")
+    return wanted
